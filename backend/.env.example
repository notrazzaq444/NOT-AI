# ============================================================
# NOT — Environment Configuration
# Copy to .env and fill real values. NEVER commit .env.
# ============================================================

# --- Server ---
NOT_HOST=127.0.0.1
NOT_PORT=8000
NOT_ENV=development
NOT_LOG_LEVEL=INFO

# --- Paths ---
NOT_DATA_DIR=../data
NOT_DB_PATH=../data/not.db
NOT_MEMORY_DIR=../data/memory
NOT_WHISPER_CACHE=../data/whisper

# --- AI Providers ---
NOT_GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
NOT_GROQ_MODEL=openai/gpt-oss-120b
NOT_GROQ_TOOL_MODEL=openai/gpt-oss-120b

NOT_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
NOT_GEMINI_MODEL=gemini-3.5-flash-lite

NOT_OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
NOT_OPENAI_MODEL=gpt-4o-mini
NOT_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE
NOT_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Search ---
NOT_TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE
NOT_BRAVE_API_KEY=your_brave_key_here
NOT_SEARCH_PRIMARY=tavily
NOT_SEARCH_FALLBACK=brave

# --- Voice ---
NOT_WHISPER_MODEL=tiny
NOT_WHISPER_DEVICE=cpu
NOT_WHISPER_COMPUTE_TYPE=int8
NOT_TTS_DEFAULT_VOICE_EN=en-US-AriaNeural
NOT_TTS_DEFAULT_VOICE_UR=ur-PK-AsadNeural
NOT_TTS_RATE=1.0
NOT_WAKE_WORD_ENABLED=false
NOT_WAKE_WORD_PHRASE=hey not
NOT_FISH_API_KEY=YOUR_FISH_API_KEY_HERE
NOT_FISH_VOICE_ID=YOUR_FISH_VOICE_ID_HERE

# --- Firebase Auth (NEW) ---
# Firebase Console → Project Settings → General → Your apps → Config
NOT_FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY
NOT_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NOT_FIREBASE_PROJECT_ID=your-project-id
NOT_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NOT_FIREBASE_MESSAGING_SENDER_ID=123456789012
NOT_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# --- Automation Safety ---
NOT_ALLOWED_FILE_ROOTS=~/Documents,~/Desktop
NOT_REQUIRE_CONFIRMATION=true
NOT_ALLOW_TERMINAL=false
NOT_ALLOW_INSTALL=false

# --- Memory ---
NOT_MEMORY_RETENTION_DAYS=365
NOT_SHORT_TERM_TURNS=12
NOT_FACT_SAVE_REQUIRES_CONSENT=true